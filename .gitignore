# ==================================
# Hexo 博客 .gitignore
# ==================================

# 1. 操作系统产生的文件
.DS_Store
Thumbs.db
desktop.ini

# 2. Node.js 依赖
node_modules/

# 3. Hexo 缓存
db.json

# 4. Hexo 生成的网站
/public/

# 5. Hexo 部署缓存
.deploy*/
.deploy_git/

# 6. 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. 临时文件
*.tmp
*.bak
*.swp
*~

# 8. 本地配置（如果包含密钥）
_config.local.yml
.env
.env.local

# 9. 编辑器配置
.vscode/
.idea/

# 10. Python 缓存（如果以后使用 Python 脚本）
__pycache__/
*.pyc

.DS_Store
Thumbs.db
db.json
*.log
node_modules/
public/
.deploy*/
_multiconfig.yml

# Duplicate upstream theme checkout. The active, tracked theme is under themes/.
/hexo-theme-anzhiyu/
