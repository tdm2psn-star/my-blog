if theme.aside.card_weixin.enable
  .card-widget.anzhiyu-right-widget#card-wechat
    .contact-title= theme.aside.card_weixin.name
    .contact-row
      span.contact-label 微信
      span= theme.aside.card_weixin.wechat
    .contact-row
      span.contact-label 邮箱
      a.contact-email(href='mailto:' + theme.aside.card_weixin.email)= theme.aside.card_weixin.email
    a.contact-details(href=theme.aside.card_weixin.link || '/wechat/') 查看联系方式
